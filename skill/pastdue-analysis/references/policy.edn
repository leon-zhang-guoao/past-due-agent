{:policy-version "3.3.7"
  :business-timezone "America/Los_Angeles"
  :business-timezone-iana "America/Los_Angeles"
  :display-timezone {:daylight-saving true
    :actual-labels ["PST" "PDT"]
    :include-utc-offset true}
  :monitor-country-allowlist ["US" "CA"]
  :atlas-country-scope :all-actual-authorized-countries
  :snapshot-calendar {:default "WEEKDAYS"
    :weekdays [1 2 3 4 5]
    :holidays nil
    :completed-before-current-local-date true
    :stale-after-workdays 2}
  :country-trigger {:relative-ratio-change-gte 0.1
    :minimum-percentage-point-change nil
    :use-unrounded-counts true}
  :interfaces {:flexible :pastdue.explore-query/rows
    :report :pastdue.report-query/rows
    :monitor :pastdue.monitor-query/countries
    :history :pastdue.history-query/trigger-events
    :missing-required :deployment-gap
    :silent-legacy-fallback false
    :compatibility-only [:pastdue.report-block-query/blocks :pastdue.monitor-block-query/countries]}
  :explore {:time-bases ["CURRENT" "SNAPSHOT" "PAIR" "RANGE"]
    :pair-policies ["PREVIOUS_AVAILABLE" "EXPLICIT"]
    :grains ["COUNTRY" "VENDOR" "VENDOR_CODE" "VENDOR_SOURCE" "VENDOR_CODE_SOURCE"]
    :denominator-scopes ["COUNTRY_ALL" "FILTERED_POPULATION" "WITHIN_VENDOR"]
    :ranking-metrics ["NONE" "PAST_DUE_COUNT" "PAST_DUE_RATIO" "PAST_DUE_SHARE" "COUNT_CHANGE" "RATIO_CHANGE" "CONTRIBUTION_CHANGE"]
    :sort-directions ["ASC" "DESC"]
    :change-selections ["ALL" "POSITIVE" "NEGATIVE" "ZERO"]
    :top-n {:all 0
      :minimum 1
      :maximum 100}
    :all-vendors 0}
  :vendor-selection {:mode "POSITIVE_TOP_N"
    :maximum-vendors 10
    :tie-breaker :vendor-code-ascending
    :coverage-reference 0.8
    :stop-at-coverage false}
  :eta-selection {:maximum-values 5
    :include-other true
    :computed-by :shared-server-facts
    :sort [:absolute-count-change-desc :target-count-desc :eta-value-asc]
    :require-complete true
    :normalize-empty-as "UNKNOWN"}
  :historical-review {:maximum-range-calendar-days 366
    :default-deep-dive :latest-trigger-per-country
    :maximum-deep-dives-per-country 5
    :previous-may-precede-range-start true
    :event-list-only-supported true}
  :test-mode {:entries ["开始测试" "start test"]
    :force-drilldown true
    :preserve-real-business-status true
    :include-optional-modules-by-default false}
  :execution {:maximum-logical-requests-per-interaction 6
    :pagination-excluded true
    :maximum-corrected-retries 1
    :recursive-fanout-fallback false
    :arbitrary-sql false
    :runtime-python false
    :host-hard-gate-installed false
    :logical-request-limit-applies-to "INTERACTIVE"
    :discovery-excluded true
    :materialization-excluded true
    :retry-same-logical-slot true
    :counts-different-logical-fact-requests-only true
    :report-presets-six-request-cap false
    :presets-attempt-all-mandatory-work true
    :broad-scope-bounds-must-be-explicit true
    :result-handle-materialization {:allowed true
      :tool "analyze_result"
      :schema-first :when-column-mapping-unverified
      :scope "retained result for this turn"
      :sql-shape "monitor: small Country rows; report: three typed projections in result-reader.md"
      :source-pages-and-result-pages-distinct true
      :row-and-cell-truncation-separate true
      :partition-union-must-cover-source true
      :prohibited ["source/database SQL" "other tables" "joins" "writes" "metric/denominator/rank/selection recomputation" "silent fact-dropping filters"]
      :select-star-allowed "monitor country rows only"
      :argument-contract "result-reader.md"
      :analyze-arguments ["result_handle" "sql" "analysis_version"]
      :analysis-version 2
      :unused-selectors :omit-not-empty-or-null
      :serialization-hook-installed false
      :unchanged-rejected-retry false
      :selector-error-component-cause "UNCONFIRMED until actual call evidence isolates it"
      :execute-arguments ["query" "retain_result"]
      :handle-only-discovery :optional-when-supported
      :read-sequence ["execute_eql and bind actual handle" "read monitor/history and pin scope" "report Control then Vendor Metrics then ETA/Check on one captured result"]
      :country-control-fields ["previous_country_past_due_count" "target_country_past_due_count" "previous_country_open" "target_country_open" "previous_country_ratio" "target_country_ratio"]
      :unprojected-fields :unknown-not-zero
      :country-control-zero-exemption false
      :report-country-concurrency 1
      :required-report-read-identity ["scope_key" "record_type" "country_code" "vendor_code" "previous_snapshot_date" "target_snapshot_date" "metric_version" "scope_status" "row_ordinal" "expected_record_count"]}}
  :evidence {:data-conflict-requires :two-raw-same-scope-contradictory-responses
    :separate-errors ["DATA_CONFLICT" "ASSOCIATION_ERROR" "REPORT_ERROR"]
    :conflict-comparison "contradictory COMMON semantic fields only, not whole response shape or capture metadata"}
  :po-line-limits {:maximum-per-vendor 5
    :maximum-per-country 20
    :allocation :one-per-vendor-then-rank-fill}
  :current-context-order [:buyer :primary :manager]
  :default-optional-modules []
  :notification-routing {:mode :display-only
    :send-enabled false
    :contact-source :atlas
    :rules [{:eta-codes ["SC" "NR" "US" "RQ"]
       :to :vendor
       :cc [:emt :buyer]} {:eta-codes ["SH" "LS"]
       :to :buyer
       :cc []} {:eta-codes ["DD"]
       :to :warehouse
       :cc [:buyer]}]}
  :metric-version "3.1.0"
  :selection-version "3.1.0"
  :calendar-version "weekdays-v1-no-holidays"
  :report-rendering {:contract-version "3.3.7"
    :standard-layout "report-format.md"
    :fact-source "structured report-query/rows"
    :country-summary-position "after Vendor ranking, before individual Vendor details"
    :interactive-composable true
    :custom-output-explicit true
    :joint-source-default-table false
    :joint-source-analysis-retained true
    :self-awarded-report-pass false
    :delivery-distinct-from-retrieval true
    :delta-only-summary-replaces-full-vendor-unit false
    :required-vendor-unit ["metrics" "Code Top5+returned Other P/T table" "Source Top5+returned Other P/T table" "Code and Source signed totals" "diagnosis or precise local failure"]
    :native-renderer-installed false
    :independent-output-review "not performed unless actually evidenced"}}
