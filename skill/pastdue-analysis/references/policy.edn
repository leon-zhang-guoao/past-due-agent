{:policy-version "3.6.2"
  :business-timezone "America/Los_Angeles"
  :business-timezone-iana "America/Los_Angeles"
  :display-timezone {:daylight-saving true
    :actual-labels ["PST" "PDT"]
    :include-utc-offset true}
  :monitor-country-allowlist ["US" "CA"]
  :atlas-country-scope :all-actual-authorized-countries
  :snapshot-calendar {:default "WEEKDAYS"
    :weekdays [1 2 3 4 5]
    :holidays nil
    :completed-before-current-local-date true
    :stale-after-workdays 2}
  :country-trigger {:relative-ratio-change-gte 0.1
    :minimum-percentage-point-change nil
    :use-unrounded-counts true}
  :interfaces {:flexible :pastdue.explore-v3-query/rows
    :flexible-set-compatible :pastdue.explore-v2-query/rows
    :flexible-compatible :pastdue.explore-query/rows
    :report :pastdue.report-query/rows
    :requested-report :select-by-report-planning-semantics
    :requested-report-added-selection :pastdue.report-v2-query/rows
    :equivalent-positive-or-single-report :pastdue.report-query/rows
    :targeted-current :pastdue.explore-v3-query/rows
    :candidate-targeted-current :pastdue.current-v2-query/rows
    :candidate-promotion :same-scope-live-comparison-required
    :monitor :pastdue.monitor-query/countries
    :history :pastdue.history-query/trigger-events
    :missing-required :deployment-gap
    :silent-legacy-fallback false
    :compatibility-only [:pastdue.report-block-query/blocks :pastdue.monitor-block-query/countries]}
  :explore {:time-bases ["CURRENT" "SNAPSHOT" "PAIR" "RANGE"]
    :pair-policies ["PREVIOUS_AVAILABLE" "EXPLICIT"]
    :grains ["COUNTRY" "VENDOR" "VENDOR_CODE" "VENDOR_SOURCE" "VENDOR_CODE_SOURCE"]
    :denominator-scopes ["COUNTRY_ALL" "FILTERED_POPULATION" "WITHIN_VENDOR"]
    :ranking-metrics ["NONE" "PAST_DUE_COUNT" "PAST_DUE_RATIO" "PAST_DUE_SHARE" "COUNT_CHANGE" "RATIO_CHANGE" "CONTRIBUTION_CHANGE"]
    :sort-directions ["ASC" "DESC"]
    :change-selections ["ALL" "POSITIVE" "NEGATIVE" "ZERO"]
    :top-n {:all 0
      :minimum 1
      :maximum 100}
    :all-vendors 0}
  :vendor-selection {:mode "POSITIVE_TOP_N"
    :maximum-vendors 10
    :tie-breaker :vendor-code-ascending
    :coverage-reference 0.8
    :stop-at-coverage false}
  :requested-report {:requires-trigger false
    :mode "INTERACTIVE"
    :default-time-basis "PAIR"
    :default-selection-mode "TOP_N"
    :explicit-vendors "VENDOR_SET"
    :explicit-vendor-top-n 0
    :source-page-size 50
    :preserve-actual-business-status true}
  :eta-selection {:maximum-values 5
    :include-other true
    :computed-by :shared-server-facts
    :sort [:absolute-count-change-desc :target-count-desc :eta-value-asc]
    :require-complete true
    :normalize-empty-as "UNKNOWN"}
  :historical-review {:maximum-range-calendar-days 366
    :default-deep-dive :latest-trigger-per-country
    :maximum-deep-dives-per-country 5
    :previous-may-precede-range-start true
    :event-list-only-supported true}
  :test-mode {:entries ["开始测试" "start test"]
    :force-drilldown true
    :preserve-real-business-status true
    :include-optional-modules-by-default false}
  :execution {:planning-review-after-source-scopes 6
    :budget-enforcement :agent-guidance-not-host-gate
    :targeted-worklists :finite-requested-scope-when-equivalent-batch-unavailable
    :source-concurrency-default 1
    :pagination-excluded-from-distinct-scopes true
    :execution-progress {:applies-to :all-modes
      :procedure "result-reader.md"
      :cost-counts [:source-execute :source-page :retained-read :discovery :correction :elapsed-time]
      :next-call-requires :named-evidence-gap-or-supported-changed-correction
      :complete-fields :reuse-under-verified-identity
      :no-supported-progress :stop-local-path-and-deliver-verified-scope
      :fixed-call-count-cap false}
    :maximum-corrected-retries 1
    :recursive-fanout-fallback false
    :arbitrary-sql false
    :runtime-python false
    :html-companion-optional-verification-script "skill/pastdue-html-report/scripts/render_ops_shell.py"
    :html-companion-verification-script-is-runtime-service false
    :host-hard-gate-installed false
    :planning-review-applies-to :all-modes
    :discovery-excluded-from-distinct-scopes true
    :materialization-excluded-from-distinct-scopes true
    :retry-same-logical-slot true
    :cost-review-is-not-completion-cap true
    :presets-attempt-all-mandatory-work true
    :broad-scope-bounds-must-be-explicit true
    :interactive-planning "interactive-planning.md"
    :explore-v2-contract "explore-v2.md"
    :explore-v3-contract "explore-v3.md"
    :result-handle-materialization {:allowed true
      :tool "analyze_result"
      :schema-first :when-column-mapping-unverified
      :scope "retained result for this turn"
      :sql-shape "monitor: small Country rows; original report: existing typed reads; paged: needed typed fields or optional full projection within actual output limits; reuse complete fields; see result-reader.md"
      :source-pages-and-result-pages-distinct true
      :row-and-cell-truncation-separate true
      :partition-union-must-cover-source true
      :prohibited ["source/database SQL" "other tables" "joins" "writes" "metric/denominator/rank/selection recomputation" "silent fact-dropping filters"]
      :select-star-allowed "monitor country rows only"
      :argument-contract "result-reader.md"
      :analyze-arguments ["result_handle" "sql" "analysis_version"]
      :analysis-version 2
      :unused-selectors :omit-not-empty-or-null
      :serialization-hook-installed false
      :unchanged-rejected-retry false
      :selector-error-component-cause "UNCONFIRMED until actual call evidence isolates it"
      :execute-arguments ["query" "retain_result"]
      :handle-only-discovery :optional-when-supported
      :read-sequence ["execute_eql and bind actual handle" "read monitor/history and pin scope" "original report: typed projections; paged: adaptive required fields, validate association/control, fill actual gaps, advance only has-more"]
      :country-control-fields ["previous_country_past_due_count" "target_country_past_due_count" "previous_country_open" "target_country_open" "previous_country_ratio" "target_country_ratio"]
      :unprojected-fields :unknown-not-zero
      :country-control-zero-exemption false
      :report-country-concurrency 1
      :required-report-read-identity ["scope_key" "record_type" "country_code" "vendor_code" "previous_snapshot_date" "target_snapshot_date" "metric_version" "scope_status" "row_ordinal" "expected_record_count"]}}
  :evidence {:data-conflict-requires :two-raw-same-scope-contradictory-responses
    :separate-errors ["DATA_CONFLICT" "ASSOCIATION_ERROR" "REPORT_ERROR"]
    :conflict-comparison "contradictory COMMON semantic fields only, not whole response shape or capture metadata"}
  :po-line-limits {:maximum-per-vendor 5
    :maximum-per-country 20
    :allocation :one-per-vendor-then-rank-fill}
  :current-context-order [:buyer :primary :manager]
  :default-optional-modules []
  :notification-routing {:mode :display-only
    :send-enabled false
    :contact-source :atlas
    :rules [{:eta-codes ["SC" "NR" "US" "RQ"]
       :to :vendor
       :cc [:emt :buyer]} {:eta-codes ["SH" "LS"]
       :to :buyer
       :cc []} {:eta-codes ["DD"]
       :to :warehouse
       :cc [:buyer]}]}
  :metric-version "3.1.0"
  :selection-version "3.1.0"
  :calendar-version "weekdays-v1-no-holidays"
  :report-rendering {:contract-version "3.3.16"
    :standard-layout "report-format.md"
    :fact-source "structured report-query/rows"
    :country-summary-position "after Vendor ranking with main ETA cells"
    :interactive-composable true
    :custom-output-explicit true
    :joint-source-default-table false
    :joint-source-analysis-retained true
    :self-awarded-report-pass false
    :delivery-distinct-from-retrieval true
    :full-six-column-eta-tables "on-request-only"
    :predicted-response-budget-omits-units false
    :prose-eta-line-replaces-main-cells false
    :required-vendor-ranking-row ["metrics" "main Code changes ≤5 by |net|" "main Source changes ≤5 by |net|" "Code and Source signed totals" "analysis status or precise local failure"]
    :native-renderer-installed false
    :html-companion {:skill "pastdue-html-report"
      :execution :native-sub-agent
      :agent-name "business-storyteller"
      :handoff-contract "skill/pastdue-html-report/references/sub-agent-contract.md"
      :child-system-prompt "skill/pastdue-html-report/references/business-storyteller.md"
      :parent-role "business analysis, payload preparation and artifact verification"
      :child-role "presentation, HTML writing and visual validation"
      :parent-inline-render-fallback false
      :verify-returned-artifacts true
      :auto-after-modes []
      :ask-after-modes ["DAILY" "TEST"]
      :html-only-when-user-requests true
      :html-only-any-payload-capable-mode true
      :explicit-html-modes ["DAILY" "TEST" "HISTORICAL" "INTERACTIVE"]
      :requires-complete-payload true
      :payload-from "same verified bindings as Markdown"
      :re-query false
      :confirm-reuses-prior-bindings true
      :scrape-markdown-as-truth false
      :authority "Markdown modules remain layout authority when MD was delivered"
      :presentation-only true
      :default-obligation-after-markdown-success false
      :forbid-vague-incomplete-payload-skip true
      :forbid-written-without-path true
      :disclose-line "HTML: WRITTEN|SPLIT|SKIPPED — reason=GATE|CAPACITY|HOST|MODE|BINDING|DELEGATE|VERIFY|OK — detail=…"
      :capacity-split-by-country true
      :gate-failure-keeps-markdown true
      :preferred-emit "business-storyteller writes equivalent HTML matching html-shell.md / payload-contract"
      :optional-verification-script "skill/pastdue-html-report/scripts/render_ops_shell.py"
      :not-a-host-markdown-renderer true}
    :independent-output-review "not performed unless actually evidenced"}}
