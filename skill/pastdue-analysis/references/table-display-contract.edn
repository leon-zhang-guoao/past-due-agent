    :signed_int {:positive-prefix "+"
      :negative-sign "−"}
    :ratio_pct {:multiply 100
      :decimals 2
      :suffix "%"}
    :pp {:multiply 100
      :decimals 4
      :suffix " pp"
      :positive-prefix "+"
      :negative-sign "−"}
