              :dvd.catalog.film_actor/actor_id {:format :id
                                                :identity? true
                                                :label "演员号"
                                                :synonyms ["actor id"]
                                                :type :integer}
              :dvd.catalog.film_actor/billing_order {:description "1 = 主演。"
                                                     :format :number
                                                     :label "番位"
                                                     :synonyms ["排位" "billing order"]
