                                          :unit "EUR"}
              :dvd.rental.payment/customer_id {:term "dvd.party/customer_id" :type :integer}
              :dvd.rental.payment/payment_date {:format :date
                                                :label "收款日期"
                                                :synonyms ["payment date"]
                                                :type :date}
              :dvd.rental.payment/payment_id {:format :id
                                              :identity? true
                                              :label "收款号"
                                              :synonyms ["payment id"]
                                              :type :integer}
              :dvd.rental.payment/rental_id {:format :id
                                             :label "借出号"
                                             :synonyms ["rental id"]
                                             :type :integer}
              :dvd.rental.payment/staff_id {:format :id
                                            :label "经手店员"
                                            :synonyms ["staff id"]
                                            :type :integer}
              :dvd.rental.rental/customer_id {:term "dvd.party/customer_id" :type :integer}
              :dvd.rental.rental/film {:cardinality :one-to-one :target "dvd.catalog.film"}
              :dvd.rental.rental/inventory_id {:format :id
