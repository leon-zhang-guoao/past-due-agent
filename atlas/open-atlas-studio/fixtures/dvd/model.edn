              :dvd.party.customer/email {:format :text
                                         :label "邮箱"
                                         :synonyms ["电子邮件" "email"]
                                         :type :string}
              :dvd.party.customer/first_name {:format :text
                                              :label "名"
                                              :synonyms ["first name"]
                                              :type :string}
              :dvd.party.customer/last_name {:format :text
                                             :label "姓"
