 :metrics {"sales_by_customer_month" {:description "开单口径的销售额：按客户、按月汇总 MSO 的订单总额。**开单不是发货**——一张 MSO 可能一件没发（demo 库里有 6 张），它仍然计入本口径。要看发出去多少，那是另一个口径，不是给这个加一个维度。"
                                      :dimensions [:cis.sales.mso/to_acct_no
                                                   :cis.sales.mso/issue_date]
                                      :entity "cis.sales.mso"
                                      :expression {:contract :duckdb-spill/v1
                                                   :text "sum(total_order)"}
                                      :grain :month
                                      :label "客户月度销售额"
                                      :synonyms ["月度销售额" "客户销售额" "sales by customer"]}
           "spend_by_vendor_month" {:description "采购口径的支出：按供应商、按月汇总 VPO 的成本合计。与销售侧那条**不是同一个概念**（同名 ≠ 同义，D2.26）：这是我们付出去的钱，故另立 metric 而不是给上一条加一个「方向」维度。"
                                    :dimensions [:cis.purchase.vpo/from_acct_no
                                                 :cis.purchase.vpo/issue_date]
                                    :entity "cis.purchase.vpo"
                                    :expression {:contract :duckdb-spill/v1 :text "sum(total_cost)"}
                                    :grain :month
                                    :label "供应商月度采购支出"
                                    :synonyms ["月度采购支出" "供应商支出" "spend by vendor"]}}
