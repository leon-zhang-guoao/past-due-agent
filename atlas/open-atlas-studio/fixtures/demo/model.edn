             {:description "The dropship VPO one shipment came from — the supplier shipped straight to the customer. Returns nothing for a normally-fulfilled SSO (that one points at an MSO instead)."
              :id "demo_sso_vpo"
              :input [:cis.sales.sso/order_no]
              :label "Dropship VPO behind a shipment"
              :output [:cis.purchase.vpo/order_no :cis.purchase.vpo/from_acct_no
                       :cis.purchase.vpo/issue_date :cis.purchase.vpo/int_ref_no]
              :result_type "single"
              :source {:query "SELECT v.order_no, v.from_acct_no, v.issue_date, v.int_ref_no FROM sso s JOIN vpos v ON v.order_no = s.int_ref_no WHERE s.order_no = :order_no AND s.int_ref_type = 2"
                       :type "sql"}
              :source-ref "cis-demo-db"}
             {:description "Audit trail of one vendor master record."
              :id "demo_vendor_audit"
              :input [:cis.master.vendor/vend_no]
              :label "Vendor audit trail"
              :output [:cis.master.vendor/entry_id :cis.master.vendor/entry_datetime
                       :cis.master.vendor/u_version]
              :result_type "single"
              :source {:query "SELECT vend_no, entry_id, entry_datetime, u_version FROM vendors WHERE vend_no = :vend_no"
                       :type "sql"}
              :source-ref "cis-demo-db"}
             {:cache {:ttl-ms 600000}
              :description "Vendor master record by vendor number."
              :id "demo_vendor_by_id"
              :input [:cis.master.vendor/vend_no]
              :label "Vendor by vend_no"
              :output [:cis.master.vendor/vend_name :cis.master.vendor/vend_type
                       :cis.master.vendor/primary_loc :cis.master.vendor/discontinued]
              :result_type "single"
              :source {:query "SELECT vend_no, vend_name, vend_type, primary_loc, discontinued FROM vendors WHERE vend_no = :vend_no"
                       :type "sql"}
              :source-ref "cis-demo-db"}
             {:description "All purchase orders (VPOs) placed on a vendor — one-to-many from vend_no via vpos.from_acct_no. Query: {:entity {:cis.master.vendor/vend_no 48332} :query [{:cis.master.vendor/vpos [:cis.purchase.vpo/order_no :cis.purchase.vpo/issue_date :cis.purchase.vpo/total_cost]}]}."
              :id "demo_vendor_vpos"
              :input [:cis.master.vendor/vend_no]
              :label "Vendor's VPOs"
              :limit {:default 50 :max 500}
              :output [{:cis.master.vendor/vpos [:cis.purchase.vpo/order_no
                                                 :cis.purchase.vpo/issue_date
                                                 :cis.purchase.vpo/ship_to_name
                                                 :cis.purchase.vpo/total_cost]}]
              :result_type "list"
              :source {:query "SELECT order_no, issue_date, ship_to_name, total_cost FROM vpos WHERE from_acct_no = :vend_no"
                       :type "sql"}
              :source-ref "cis-demo-db"}
             {:description "Vendor purchase-order header by order number."
              :id "demo_vpo_by_id"
              :input [:cis.purchase.vpo/order_no]
              :label "VPO header by order_no"
              :output [:cis.purchase.vpo/order_type :cis.purchase.vpo/total_cost
                       :cis.purchase.vpo/freight :cis.purchase.vpo/ship_to_name
                       :cis.purchase.vpo/ship_to_city :cis.purchase.vpo/ship_to_state
                       :cis.purchase.vpo/issue_date :cis.purchase.vpo/expected_date
                       :cis.purchase.vpo/from_acct_no :cis.purchase.vpo/to_acct_no
                       :cis.purchase.vpo/int_ref_no]
              :result_type "single"
              :source {:query "SELECT order_no, order_type, total_cost, freight, ship_to_name, ship_to_city, ship_to_state, issue_date, expected_date, from_acct_no, to_acct_no, int_ref_no FROM vpos WHERE order_no = :order_no"
                       :type "sql"}
              :source-ref "cis-demo-db"}
             {:description "Per-line delivery ETA tracking for a VPO — original vs current ETA, status,\n                 carrier, tracking, delay (one-to-many)."
              :id "demo_vpo_eta_detail"
              :input [:cis.purchase.vpo/order_no]
              :label "VPO ETA detail"
              :limit {:default 50 :max 500}
              :output [{:cis.purchase.vpo/eta_detail [:cis.purchase.vpo_eta_detail/line_no
                                                      :cis.purchase.vpo_eta_detail/sku_no
                                                      :cis.purchase.vpo_eta_detail/original_eta
                                                      :cis.purchase.vpo_eta_detail/current_eta
                                                      :cis.purchase.vpo_eta_detail/actual_arrival
                                                      :cis.purchase.vpo_eta_detail/eta_status
                                                      :cis.purchase.vpo_eta_detail/carrier_no
                                                      :cis.purchase.vpo_eta_detail/tracking_no
                                                      :cis.purchase.vpo_eta_detail/delay_days
                                                      :cis.purchase.vpo_eta_detail/updated_date
                                                      :cis.purchase.vpo_eta_detail/order_no]}]
              :result_type "list"
              :source {:query "SELECT order_no, line_no, sku_no, original_eta, current_eta, actual_arrival, eta_status, carrier_no, tracking_no, delay_days, updated_date FROM vpo_eta_detail WHERE order_no = :order_no"
                       :type "sql"}
              :source-ref "cis-demo-db"}
             {:description "Audit trail, ship-to detail, receiving timeline and order amounts of one purchase order — the columns the base VPO resolver does not carry."
              :id "demo_vpo_extended"
              :input [:cis.purchase.vpo/order_no]
              :label "VPO extended header"
              :output [:cis.purchase.vpo/entry_id :cis.purchase.vpo/entry_datetime
                       :cis.purchase.vpo/update_id :cis.purchase.vpo/update_datetime
                       :cis.purchase.vpo/u_version :cis.purchase.vpo/ship_to_addr
                       :cis.purchase.vpo/ship_to_zip :cis.purchase.vpo/receiving_date
                       :cis.purchase.vpo/closed_date :cis.purchase.vpo/total_order
                       :cis.purchase.vpo/detail_price_total]
              :result_type "single"
              :source {:query "SELECT order_no, entry_id, entry_datetime, update_id, update_datetime, u_version, ship_to_addr, ship_to_zip, receiving_date, closed_date, total_order, detail_price_total FROM vpos WHERE order_no = :order_no"
                       :type "sql"}
              :source-ref "cis-demo-db"}
             {:description "Line items for a VPO (one-to-many). A large order can be NARROWED instead of returning every line: filter by :vend_part_no (SQL LIKE, % wildcard), page with :limit/:offset (first N), or sort with :order_by/:sort_dir (e.g. :order_by \"line_no\" :sort_dir \"DESC\" :limit 5 = the last 5 lines)."
              :eql-params {:vend_part_no {:attribute :cis.purchase.vpo_order_detail/vend_part_no
                                          :description "Filter line items by vendor part number — SQL LIKE, use % wildcard (e.g. \"MFG-A%\")."
                                          :op :like}}
              :id "demo_vpo_order_detail"
              :input [:cis.purchase.vpo/order_no]
              :label "VPO line items"
              :limit {:default 50 :max 500}
              :order {:allowed [:cis.purchase.vpo_order_detail/line_no
                                :cis.purchase.vpo_order_detail/vend_part_no
                                :cis.purchase.vpo_order_detail/order_qty
                                :cis.purchase.vpo_order_detail/ship_qty
                                :cis.purchase.vpo_order_detail/unit_cost]
                      :default [:cis.purchase.vpo_order_detail/line_no :asc]}
              :output [{:cis.purchase.vpo/order_detail [:cis.purchase.vpo_order_detail/line_no
                                                        :cis.purchase.vpo_order_detail/sku_no
                                                        :cis.purchase.vpo_order_detail/vend_part_no
                                                        :cis.purchase.vpo_order_detail/order_qty
                                                        :cis.purchase.vpo_order_detail/ship_qty
                                                        :cis.purchase.vpo_order_detail/unit_cost
                                                        :cis.purchase.vpo_order_detail/order_no]}]
              :result_type "list"
              :source {:query "SELECT order_no, line_no, sku_no, vend_part_no, order_qty, ship_qty, unit_cost FROM vpo_order_details WHERE order_no = :order_no"
                       :type "sql"}
              :source-ref "cis-demo-db"}
             {:description "Derived audit summary — who entered/updated the record and when."
              :id "derived_customer_audit_info"
              :input [:cis.master.customer/entry_id :cis.master.customer/entry_datetime
                      :cis.master.customer/u_version]
              :label "customer audit info (derived)"
              :output [:cis.master.customer/audit_info]
              :result_type "single"
              :source {:expr "(str \"entry \" entry_id \" @ \" entry_datetime (when u_version (str \" · v\" u_version)))"
                       :type "derived"}}
             {:description "Derived audit summary — who entered/updated the record and when."
              :id "derived_customer_credit_audit_info"
              :input [:cis.master.customer_credit/entry_id
                      :cis.master.customer_credit/entry_datetime
                      :cis.master.customer_credit/u_version]
              :label "customer_credit audit info (derived)"
              :output [:cis.master.customer_credit/audit_info]
              :result_type "single"
              :source {:expr "(str \"entry \" entry_id \" @ \" entry_datetime (when u_version (str \" · v\" u_version)))"
                       :type "derived"}}
             {:description "Derived audit summary — who entered/updated the record and when."
              :id "derived_mso_audit_info"
              :input [:cis.sales.mso/entry_id :cis.sales.mso/entry_datetime :cis.sales.mso/update_id
                      :cis.sales.mso/update_datetime :cis.sales.mso/u_version]
              :label "mso audit info (derived)"
              :output [:cis.sales.mso/audit_info]
              :result_type "single"
              :source {:expr "(str \"entry \" entry_id \" @ \" entry_datetime (when update_id (str \" · update \" update_id \" @ \" update_datetime)) (when u_version (str \" · v\" u_version)))"
                       :type "derived"}}
             {:description "Derived release-control summary: approval, hold and credit release."
              :id "derived_mso_releases_info"
              :input [:cis.sales.mso/approval :cis.sales.mso/hold_id :cis.sales.mso/hold_date
                      :cis.sales.mso/credit_rel_date]
              :label "MSO releases (derived)"
              :output [:cis.sales.mso/releases_info]
              :result_type "single"
              :source {:expr "(str \"approval \" approval \" · hold \" hold_id \" @ \" hold_date \" · credit-released \" credit_rel_date)"
                       :type "derived"}}
             {:description "Derived one-line ship-to address of the sales order."
              :id "derived_mso_ship_to_info"
              :input [:cis.sales.mso/ship_to_name :cis.sales.mso/ship_to_addr
                      :cis.sales.mso/ship_to_city :cis.sales.mso/ship_to_state
                      :cis.sales.mso/ship_to_zip :cis.sales.mso/ship_to_country]
              :label "MSO ship-to (derived)"
              :output [:cis.sales.mso/ship_to_info]
              :result_type "single"
              :source {:expr "(str ship_to_name \" · \" ship_to_addr \" \" ship_to_city \" \" ship_to_state \" \" ship_to_zip \" \" ship_to_country)"
                       :type "derived"}}
             {:description "Derived money summary of the sales order."
              :id "derived_mso_so_amounts_info"
              :input [:cis.sales.mso/total_order :cis.sales.mso/sales_total]
              :label "MSO amounts (derived)"
              :output [:cis.sales.mso/so_amounts_info]
              :result_type "single"
              :source {:expr "(str \"order \" total_order \" · sales \" sales_total)"
                       :type "derived"}}
             {:description "Derived warehouse milestones in fulfilment order: pick → qc → label → ship → bol. Missing steps read as blank — that is the answer."
              :id "derived_mso_warehouse_ops_info"
              :input [:cis.sales.mso/pick_date :cis.sales.mso/qc_date :cis.sales.mso/label_date
                      :cis.sales.mso/ship_date :cis.sales.mso/bol_date]
              :label "MSO warehouse ops (derived)"
              :output [:cis.sales.mso/warehouse_ops_info]
              :result_type "single"
              :source {:expr "(str \"pick \" pick_date \" · qc \" qc_date \" · label \" label_date \" · ship \" ship_date \" · bol \" bol_date)"
                       :type "derived"}}
             {:description "Derived audit summary — who entered/updated the record and when."
              :id "derived_part_audit_info"
              :input [:cis.master.part/entry_id :cis.master.part/entry_datetime
                      :cis.master.part/u_version]
              :label "part audit info (derived)"
              :output [:cis.master.part/audit_info]
              :result_type "single"
              :source {:expr "(str \"entry \" entry_id \" @ \" entry_datetime (when u_version (str \" · v\" u_version)))"
                       :type "derived"}}
             {:description "Derived audit summary — who entered/updated the record and when."
              :id "derived_vendor_audit_info"
              :input [:cis.master.vendor/entry_id :cis.master.vendor/entry_datetime
                      :cis.master.vendor/u_version]
              :label "vendor audit info (derived)"
              :output [:cis.master.vendor/audit_info]
              :result_type "single"
              :source {:expr "(str \"entry \" entry_id \" @ \" entry_datetime (when u_version (str \" · v\" u_version)))"
                       :type "derived"}}
             {:description "Derived audit summary — who entered/updated the record and when."
              :id "derived_vpo_audit_info"
              :input [:cis.purchase.vpo/entry_id :cis.purchase.vpo/entry_datetime
                      :cis.purchase.vpo/update_id :cis.purchase.vpo/update_datetime
                      :cis.purchase.vpo/u_version]
              :label "vpo audit info (derived)"
              :output [:cis.purchase.vpo/audit_info]
              :result_type "single"
              :source {:expr "(str \"entry \" entry_id \" @ \" entry_datetime (when update_id (str \" · update \" update_id \" @ \" update_datetime)) (when u_version (str \" · v\" u_version)))"
                       :type "derived"}}
             {:description "Derived money summary of the purchase order (composite tier follows the strictest member)."
              :id "derived_vpo_po_amounts_info"
              :input [:cis.purchase.vpo/total_order :cis.purchase.vpo/total_cost
                      :cis.purchase.vpo/freight :cis.purchase.vpo/detail_price_total]
              :label "VPO amounts (derived)"
              :output [:cis.purchase.vpo/po_amounts_info]
              :result_type "single"
              :source {:expr "(str \"order \" total_order \" · cost \" total_cost \" · freight \" freight \" · lines \" detail_price_total)"
                       :type "derived"}}
             {:description "Derived receiving timeline of the purchase order: issued → expected → received → closed."
              :id "derived_vpo_receiving_dates_info"
              :input [:cis.purchase.vpo/issue_date :cis.purchase.vpo/expected_date
                      :cis.purchase.vpo/receiving_date :cis.purchase.vpo/closed_date]
              :label "VPO receiving timeline (derived)"
              :output [:cis.purchase.vpo/receiving_dates_info]
              :result_type "single"
              :source {:expr "(str \"issued \" issue_date \" · expected \" expected_date \" · received \" receiving_date \" · closed \" closed_date)"
                       :type "derived"}}
             {:description "Derived one-line ship-to address of the purchase order."
              :id "derived_vpo_ship_to_info"
              :input [:cis.purchase.vpo/ship_to_name :cis.purchase.vpo/ship_to_addr
                      :cis.purchase.vpo/ship_to_city :cis.purchase.vpo/ship_to_state
                      :cis.purchase.vpo/ship_to_zip]
              :label "VPO ship-to (derived)"
              :output [:cis.purchase.vpo/ship_to_info]
              :result_type "single"
              :source {:expr "(str ship_to_name \" · \" ship_to_addr \" \" ship_to_city \" \" ship_to_state \" \" ship_to_zip)"
                       :type "derived"}}]
 :sources {"cis-demo-db" {:jdbc_url "jdbc:sqlite:data/cis-demo.db" :type "sql"}}
 :terms {"cis.catalog/sku_no" {:description "目录里一个可售卖单元的内部编号。它是**我们的**编号，与厂商料号（`part_no`）和客户自己的料号都不是一回事。"
                               :format :id
                               :label "物料号"
                               :synonyms ["SKU编号" "SKU" "内部物料号" "sku no" "sku number" "item no"]}
         "cis.doc/issue_date" {:description "这张单据开出来的日期。它**不是**业务发生的日期——发货看 `ship_date`，开票看 `invoice_date`。"
                               :format :date
                               :label "签发日期"
                               :synonyms ["开单日期" "下单日期" "单据日期" "issue date" "order date"]}
         "cis.doc/order_type" {:description "这张单是什么单。`CIS.dbo.order_header` 用它把销售单与采购单放在同一张表里——四个 entity 共用一张表、靠这一列区分，所以它不只是个标签，是**读这张表的前提**。"
                               :format :code
                               :label "单据类型"
                               :synonyms ["单据类型" "订单类型" "order type"]
                               :values {1 {:description "卖给客户的单（MSO 合同与 SSO 发货单都是 1）。" :label "销售单"}
                                        2 {:description "向供应商下的单（VPO）。" :label "采购单"}
                                        8 {:description "backlog order —— 已接单但暂时无法履约、挂在那里等货的单。"
                                           :label "欠单"}}}
         "cis.line/order_qty" {:description "这一行**订了多少**。MSO 上是合同的全量，SSO 上是这一次发货分摊到的量。"
                               :format :number
                               :label "订货数量"
                               :synonyms ["订货量" "订单数量" "order qty" "ordered quantity"]}
         "cis.line/ship_qty" {:description "这一行**已经发了多少**。与 `order_qty` 的差就是未发量——部分发货时两者不等。"
                              :format :number
                              :label "已发数量"
                              :synonyms ["发货量" "已发量" "ship qty" "shipped quantity"]}
         "cis.money/net_price" {:description "这一行折让之后的实收金额。它是**这一行的结果**，不是单价乘数量的必然值——折扣、附加费都落在这里。"
                                :format :currency
                                :label "行净额"
                                :synonyms ["净额" "行金额" "net price" "extended price"]}
         "cis.money/total_order" {:description "整张单的金额合计。采购单上是我们要付的，销售单上是客户要付的——**方向由单据类型决定，不由这个数字本身说明**。"
                                  :format :currency
                                  :label "单据总额"
                                  :synonyms ["订单总额" "单据总额" "total order" "order total"]}
         "cis.money/unit_cost" {:description "这一行每单位货的成本。**我们付出去的钱**，与卖价（`unit_price`）是两回事。"
                                :format :currency
                                :label "单位成本"
                                :synonyms ["单位成本" "进价" "unit cost" "cost per unit"]}
         "cis.money/unit_price" {:description "这一行每单位货的售价。**客户付给我们的钱**，与成本（`unit_cost`）是两回事。"
                                 :format :currency
                                 :label "单价"
                                 :synonyms ["单价" "售价" "unit price" "price per unit"]}
         "cis.order/ship_to_info" {:description "这张单据发到哪里，汇成一行：收货方名称、街道、城市、州省、邮编（销售单还有国家）。销售单与采购单**共用**这一条定义——同一个概念、不同的当事人，谁发给谁的差别写在各自的 `:term-context` 上（绑定用长形，见下面绑定那一段）。成员**保持列出**（不像审计族）：`ship_to_city = 'Cary'` 这种按成员过滤是真需求，藏起来就等于砍掉它。"
                                   :format :text
                                   :label "收货地址"
                                   :synonyms ["收货地址" "送货地址" "收货方" "ship to" "ship-to address"]}
         "cis.party/customer_no" {:description "我们**卖给**的那一方的账号。TD SYNNEX 这类既买又卖的组织在库里有客户与供应商两条记录、两个号——它们是同一家公司的两个身份，不是同一个号（见本文件上面关于 party link 的那一段）。"
                                  :format :id
                                  :label "客户号"
                                  :synonyms ["客户编号" "客户账号" "customer no" "customer number" "sold-to"
                                             "bill-to"]}
         "cis.party/vendor_no" {:description "我们**买自**的那一方的账号。VPO 上写成 `from_acct_no`（货从哪个账号来），主数据上写成 `vend_no`——同一个概念。"
                                :format :id
                                :label "供应商号"
                                :synonyms ["供应商编号" "厂商号" "vendor no" "vendor number" "ship-from"]}
         "cis.ship/ship_to_addr" {:description "收货地址的街道行。城市/州/邮编另有其列——它们合起来才是一个地址（`g_ship_to`）。"
                                  :format :text
                                  :label "收货街道地址"
                                  :synonyms ["收货地址" "街道地址" "ship to address" "street"]}
         "cis.ship/ship_to_city" {:description "收货地址的城市。"
                                  :format :text
                                  :label "收货城市"
                                  :synonyms ["收货城市" "到货城市" "ship to city"]}
         "cis.ship/ship_to_name" {:description "货发给谁（收货人/收货公司）。**不一定是客户本人**——dropship 时货直发终端客户，而账单仍开给下单的那一方。"
                                  :format :text
                                  :label "收货方名称"
                                  :synonyms ["收货人" "收货方" "ship to name" "consignee"]}
         "cis.ship/ship_to_state" {:description "收货地址的州或省。US 两位州码。"
                                   :format :text
                                   :label "收货州/省"
                                   :synonyms ["收货州" "州" "省" "ship to state"]}
         "cis.ship/ship_to_zip" {:description "收货地址的邮政编码。"
                                 :format :text
                                 :label "收货邮编"
                                 :synonyms ["邮编" "邮政编码" "zip" "postal code"]}
         "common.audit/audit_info" {:description "这条记录的审计痕迹汇成的一句话：谁录的、何时录的，改过的话还有谁改的、何时改的，以及行版本号。它回答的是「**这条记录是怎么来的**」，与记录本身的业务含义无关。各 entity 汇总的是它实有的那几个审计字段——单据头有录入与修改两套，主档只有录入，**没有的就不写**。成员本身都是 `:listed? false`（D2.28）：没人会按录入人过滤，收进目录只是噪音；要看就看这一句。"
                                    :format :text
                                    :label "审计信息"
                                    :synonyms ["审计信息" "审计痕迹" "录入修改痕迹" "audit info" "audit trail"]}
         "common.audit/created_at" {:description "记录被创建的时刻。它**早于**这条记录描述的业务事件——单子是先录进来，再发生后面的事。"
                                    :label "录入时间"
                                    :synonyms ["录入时间" "创建时间" "created at" "entry date"]}
         "common.audit/created_by" {:description "创建这条记录的操作员。**是谁把它录进系统的**，与记录的业务含义无关。"
                                    :label "录入人"
                                    :synonyms ["录入者" "创建人" "created by" "entered by"]}
