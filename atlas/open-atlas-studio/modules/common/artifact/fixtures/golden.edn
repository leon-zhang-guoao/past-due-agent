             :file-hashes {"content.edn" "{:artifact/format-version 1\n :objects {:attributes {:cis.master.part/all_parts {:label \"SKU 目录全集\" :target \"cis.master.part\"}\n                        :cis.master.part/ave_cost {:description \"Average unit cost.\"\n                                                   :format :currency\n                                                   :label \"Average Cost\"\n                                                   :type :decimal}\n                        :cis.master.part/part_no {:description \"Manufacturer part number.\"\n                                                  :format :id\n                                                  :label \"Part No\"\n                                                  :type :string}\n                        :cis.master.part/prod_code {:description \"Product code.\"\n                                                    :format :code\n                                                    :label \"Product Code\"\n                                                    :type :string\n                                                    :values {\"A\" {:label \"Assembly\"}\n                                                             \"R\" {:label \"Raw\"}}}\n                        :cis.master.part/short_desc {:description \"Short description.\"\n                                                     :format :text\n                                                     :label \"Description\"\n                                                     :type :string}\n                        :cis.master.part/sku_no {:description \"Unique SKU number.\"\n                                                 :format :id\n                                                 :identity? true\n                                                 :label \"SKU No\"\n                                                 :type :integer}\n                        :cis.master.part/vend_no {:description \"Vendor number that supplies this part.\"\n                                                  :format :id\n                                                  :label \"Vendor No\"\n                                                  :type :integer}\n                        :cis.master.vendor/contact_email {:description \"Primary contact email.\"\n                                                          :format :text\n                                                          :label \"Contact Email\"\n                                                          :type :string}\n                        :cis.master.vendor/discontinued {:description \"Whether the vendor is discontinued.\"\n                                                         :format :code\n                                                         :label \"Discontinued\"\n                                                         :type :string\n                                                         :values {\"N\" {:label \"在用\"}\n                                                                  \"Y\" {:label \"已停用\"}}}\n                        :cis.master.vendor/entry_by {:description \"Who created the record.\"\n                                                     :format :text\n                                                     :label \"Entry By\"\n                                                     :type :string}\n                        :cis.master.vendor/entry_date {:description \"When the record was created.\"\n                                                       :format :date\n                                                       :label \"Entry Date\"\n                                                       :type :date}\n                        :cis.master.vendor/parts {:cardinality :one-to-many\n                                                  :label \"该供应商供货的 part\"\n                                                  :target \"cis.master.part\"}\n                        :cis.master.vendor/vend_name {:description \"Vendor display name.\"\n                                                      :format :text\n                                                      :label \"Vendor Name\"\n                                                      :type :string}\n                        :cis.master.vendor/vend_no {:description \"Unique vendor number.\"\n                                                    :format :id\n                                                    :identity? true\n                                                    :label \"Vendor No\"\n                                                    :type :integer}}\n           :links [{:cardinality :one-to-many\n                    :description \"A vendor supplies many parts.\"\n                    :from :cis.master.vendor/vend_no\n                    :to :cis.master.part/vend_no}]\n           :namespaces {\"cis.master.part\" {:kind :master\n                                           :label \"Part — catalog item (SKU)\"\n                                           :synonyms [\"零件\" \"物料\"]}\n                        \"cis.master.vendor\" {:kind :master\n                                             :label \"Vendor — supplier on a purchase order\"\n                                             :synonyms [\"供应商\" \"supplier\"]}}\n           :resolvers [{:curated? true\n                        :description \"SKU 目录全集——小型主档，量级由作者签字；可按 :prod_code 收窄。\"\n                        :eql-params {:prod_code {:attribute :cis.master.part/prod_code\n                                                 :description \"只取该产品码的 part。\"\n                                                 :op :eq}}\n                        :id \"demo_all_parts\"\n                        :input []\n                        :label \"All parts (SKU catalog)\"\n                        :limit {:default 50 :max 500}\n                        :order {:allowed [:cis.master.part/sku_no :cis.master.part/part_no]\n                                :default [:cis.master.part/sku_no :asc]}\n                        :output [{:cis.master.part/all_parts [:cis.master.part/sku_no\n                                                              :cis.master.part/part_no\n                                                              :cis.master.part/short_desc\n                                                              :cis.master.part/ave_cost\n                                                              :cis.master.part/prod_code]}]\n                        :result_type \"list\"\n                        :source {:query \"SELECT sku_no, part_no, short_desc, ave_cost, prod_code FROM parts\"\n                                 :type \"sql\"}\n                        :source-ref \"cis-demo-db\"}\n                       {:description \"Catalog part by SKU；batch：一条 WHERE sku_no IN (...) 消 N+1。\"\n                        :id \"demo_part_by_id\"\n                        :input [:cis.master.part/sku_no]\n                        :label \"Part by sku_no\"\n                        :output [:cis.master.part/part_no :cis.master.part/short_desc\n                                 :cis.master.part/ave_cost :cis.master.part/prod_code\n                                 :cis.master.part/vend_no]\n                        :result_type \"single\"\n                        :source {:batch {:child-fk \"sku_no\"\n                                         :parent-key :cis.master.part/sku_no\n                                         :placeholder \"sku_nos\"}\n                                 :query \"SELECT sku_no, part_no, short_desc, ave_cost, prod_code, vend_no FROM parts WHERE sku_no IN (:sku_nos)\"\n                                 :type \"sql\"}\n                        :source-ref \"cis-demo-db\"}\n                       {:description \"该供应商供货的 part（navigation 的解析器）；batch 消 N+1，分页是 per-parent 窗口。\"\n                        :id \"demo_parts_by_vendor\"\n                        :input [:cis.master.vendor/vend_no]\n                        :label \"Parts by vendor\"\n                        :limit {:default 2 :max 5}\n                        :order {:allowed [:cis.master.part/sku_no :cis.master.part/part_no]\n                                :default [:cis.master.part/sku_no :asc]}\n                        :output [{:cis.master.vendor/parts [:cis.master.part/sku_no\n                                                            :cis.master.part/part_no\n                                                            :cis.master.part/ave_cost]}]\n                        :result_type \"list\"\n                        :source {:batch {:child-fk \"vend_no\"\n                                         :parent-key :cis.master.vendor/vend_no\n                                         :placeholder \"vend_nos\"}\n                                 :query \"SELECT vend_no, sku_no, part_no, ave_cost FROM parts WHERE vend_no IN (:vend_nos)\"\n                                 :type \"sql\"}\n                        :source-ref \"cis-demo-db\"}\n                       {:description \"Vendor master record by vendor number.\"\n                        :id \"demo_vendor_by_id\"\n                        :input [:cis.master.vendor/vend_no]\n                        :label \"Vendor by vend_no\"\n                        :output [:cis.master.vendor/vend_name :cis.master.vendor/discontinued\n                                 :cis.master.vendor/contact_email :cis.master.vendor/entry_by\n                                 :cis.master.vendor/entry_date]\n                        :result_type \"single\"\n                        :source {:query \"SELECT vend_no, vend_name, discontinued, contact_email, entry_by, entry_date FROM vendors WHERE vend_no = :vend_no\"\n                                 :type \"sql\"}\n                        :source-ref \"cis-demo-db\"}]\n           :sources {\"cis-demo-db\" {:description \"B1 竖切用的内存 SQLite。\"\n                                    :jdbc_url \"${B1_JDBC_URL}\"\n                                    :label \"CIS demo DB\"\n                                    :type \"sql\"}}\n      