;; sql 连接器：contracts/connectors/sql-v1.md 的实现。
;; 依赖 SPI 而不被 SPI 依赖；engine 也不直接依赖它——连接器是可插拔的，
;; 由装配处（app）决定加载哪些。
{:paths ["src"]
 :deps  {org.clojure/clojure       {:mvn/version "1.11.4"}
         open.atlas/connector-spi  {:local/root "../connector-spi"}
         ;; Declared, not inherited: the closed `:resilience` / `:policy` key
         ;; face and the failure vocabulary are the dialect's (doc 107 §107.3),
         ;; and `impl.validate` requires it directly.
         open.atlas/dialect        {:local/root "../dialect"}
         ;; JDBC：next.jdbc 是 prepared statement 的直路（值永不字符串插值）；
         ;; HikariCP 提供 :max_pool_size/:min_idle 与查询超时的执行点。
         com.github.seancorfield/next.jdbc {:mvn/version "1.3.939"}
         com.zaxxer/HikariCP               {:mvn/version "5.1.0"}}
 :aliases
 ;; fixtures/b1 进 classpath：端到端用例用 io/resource 读 "schema.sql"，
 ;; 与根 deps.edn 的 :test alias 挂的是同一份（fixtures/b1/README：
 ;; 「两个模块的 :test alias 都把本目录挂进 classpath，端到端用例读同一份」）。
 {:test {:extra-paths ["test" "../../../fixtures/b1"]
         :extra-deps  {io.github.cognitect-labs/test-runner
                       {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                       ;; 真跑 SQL 的 conformance：内存 SQLite，无外部依赖
                       org.xerial/sqlite-jdbc {:mvn/version "3.46.1.0"}}
         :main-opts   ["-m" "cognitect.test-runner"]}}}
