{:namespaces
 {"pastdue.historical-vendor-contribution"
  {:label "PastDue Historical Vendor Contribution"
   :domain "PastDue"
   :description "Vendor-level decomposition for an explicit historical country target/previous snapshot pair."}}

 :attributes
 {:pastdue.historical-vendor-contribution/country-code
  {:type :string :identity? true :label "Country Code"
   :description "Country component of the historical vendor identity." :format :code}
  :pastdue.historical-vendor-contribution/vendor-code
  {:type :integer :identity? true :label "Vendor Code"
   :description "Vendor component of the identity; not assumed globally unique across countries." :format :id}
  :pastdue.historical-vendor-contribution/target-snapshot-date
  {:type :date :identity? true :label "Target Snapshot Date"
   :description "Historical completed snapshot being explained." :format :date}
  :pastdue.historical-vendor-contribution/previous-snapshot-date
  {:type :date :identity? true :label "Previous Snapshot Date"
   :description "Nearest prior available snapshot used as the comparison baseline." :format :date}
  :pastdue.historical-vendor-contribution/vendor-name
  {:type :string :label "Vendor Name"
   :description "Latest available vendor name across the explicit historical pair." :format :text :nullable? true}
  :pastdue.historical-vendor-contribution/target-past-due-count
  {:type :integer :label "Target Vendor Past-Due Count"
   :description "Vendor past-due PO-line count in the target snapshot." :unit "PO lines" :format :number}
  :pastdue.historical-vendor-contribution/previous-past-due-count
  {:type :integer :label "Previous Vendor Past-Due Count"
   :description "Vendor past-due PO-line count in the previous snapshot." :unit "PO lines" :format :number}
  :pastdue.historical-vendor-contribution/past-due-count-change
  {:type :integer :label "Vendor Past-Due Count Change"
   :description "Target minus previous vendor past-due count." :unit "PO lines" :format :number}
  :pastdue.historical-vendor-contribution/target-open-count
  {:type :integer :label "Target Vendor Open Count"
   :description "Vendor open PO-line count in the target snapshot." :unit "PO lines" :format :number}
  :pastdue.historical-vendor-contribution/previous-open-count
  {:type :integer :label "Previous Vendor Open Count"
   :description "Vendor open PO-line count in the previous snapshot." :unit "PO lines" :format :number}
  :pastdue.historical-vendor-contribution/open-count-change
  {:type :integer :label "Vendor Open Count Change"
   :description "Target minus previous vendor open count." :unit "PO lines" :format :number}
  :pastdue.historical-vendor-contribution/target-vendor-ratio
  {:type :decimal :label "Target Vendor Past-Due Ratio"
   :description "Target vendor past-due count divided by target vendor open count." :unit "%" :format :percent}
  :pastdue.historical-vendor-contribution/previous-vendor-ratio
  {:type :decimal :label "Previous Vendor Past-Due Ratio"
   :description "Previous vendor past-due count divided by previous vendor open count." :unit "%" :format :percent}
  :pastdue.historical-vendor-contribution/vendor-ratio-change
  {:type :decimal :label "Vendor Ratio Change"
   :description "Target vendor ratio minus previous vendor ratio." :unit "percentage points" :format :number}
  :pastdue.historical-vendor-contribution/target-country-contribution
  {:type :decimal :label "Target Country Contribution"
   :description "Target vendor past-due count divided by target country open count." :unit "%" :format :percent}
  :pastdue.historical-vendor-contribution/previous-country-contribution
  {:type :decimal :label "Previous Country Contribution"
   :description "Previous vendor past-due count divided by previous country open count." :unit "%" :format :percent}
  :pastdue.historical-vendor-contribution/delta-country-contribution
  {:type :decimal :label "Delta Country Contribution"
   :description "Vendor contribution to the explicit historical country ratio change."
   :synonyms ["历史供应商贡献"] :unit "percentage points" :format :number}
  :pastdue.historical-vendor-contribution/positive-contribution-share
  {:type :decimal :label "Positive Contribution Share"
   :description "Vendor positive delta divided by all positive vendor deltas for this historical pair." :unit "%" :format :percent}
  :pastdue.historical-vendor-contribution/cumulative-positive-share
  {:type :decimal :label "Cumulative Positive Share"
   :description "Cumulative positive share in descending historical contribution order." :unit "%" :format :percent}
  :pastdue.historical-vendor-contribution/contribution-rank
  {:type :integer :label "Contribution Rank"
   :description "Stable descending positive-contribution rank for this historical pair." :format :number}}

 :resolvers
 [{:id "pastdue_historical_positive_vendor_contributors"
   :name "Historical Positive Vendor Contributors"
   :description "Positive vendor contributors for an explicit valid historical snapshot pair. The previous date must be the nearest available date before the target."
   :domain "PastDue"
   :source-ref "eta-clickhouse-prod"
   :input ["pastdue.country-trigger-event/country-code"
           "pastdue.country-trigger-event/target-snapshot-date"
           "pastdue.country-trigger-event/previous-snapshot-date"]
   :output [{:pastdue.country-trigger-event/positive-vendor-contributors
             ["pastdue.historical-vendor-contribution/country-code"
              "pastdue.historical-vendor-contribution/vendor-code"
              "pastdue.historical-vendor-contribution/target-snapshot-date"
              "pastdue.historical-vendor-contribution/previous-snapshot-date"
              "pastdue.historical-vendor-contribution/vendor-name"
              "pastdue.historical-vendor-contribution/target-past-due-count"
              "pastdue.historical-vendor-contribution/previous-past-due-count"
              "pastdue.historical-vendor-contribution/past-due-count-change"
              "pastdue.historical-vendor-contribution/target-open-count"
              "pastdue.historical-vendor-contribution/previous-open-count"
              "pastdue.historical-vendor-contribution/open-count-change"
              "pastdue.historical-vendor-contribution/target-vendor-ratio"
              "pastdue.historical-vendor-contribution/previous-vendor-ratio"
              "pastdue.historical-vendor-contribution/vendor-ratio-change"
              "pastdue.historical-vendor-contribution/target-country-contribution"
              "pastdue.historical-vendor-contribution/previous-country-contribution"
              "pastdue.historical-vendor-contribution/delta-country-contribution"
              "pastdue.historical-vendor-contribution/positive-contribution-share"
              "pastdue.historical-vendor-contribution/cumulative-positive-share"
              "pastdue.historical-vendor-contribution/contribution-rank"]}]
   :source
   {:type "sql" :result_type "list"
    :query "WITH country_daily AS (SELECT snapshot_date, country_code, sum(toInt64(total_open_count)) AS country_open FROM past_due.vendor_past_due_daily WHERE snapshot_date < toDate(now('America/Los_Angeles')) AND country_code = :country_code GROUP BY snapshot_date, country_code), periods AS (SELECT country_code, toDate(:target_snapshot_date) AS target_snapshot_date, toDate(:previous_snapshot_date) AS previous_snapshot_date, sumIf(country_open, snapshot_date = toDate(:target_snapshot_date)) AS target_country_open, sumIf(country_open, snapshot_date = toDate(:previous_snapshot_date)) AS previous_country_open FROM country_daily GROUP BY country_code HAVING toDate(:target_snapshot_date) < toDate(now('America/Los_Angeles')) AND toDate(:previous_snapshot_date) < toDate(:target_snapshot_date) AND countIf(snapshot_date = toDate(:target_snapshot_date)) > 0 AND countIf(snapshot_date = toDate(:previous_snapshot_date)) > 0 AND maxIf(snapshot_date, snapshot_date < toDate(:target_snapshot_date)) = toDate(:previous_snapshot_date)), period_rows AS (SELECT country_code, target_snapshot_date, previous_snapshot_date, target_country_open, previous_country_open, target_snapshot_date AS snapshot_date FROM periods UNION ALL SELECT country_code, target_snapshot_date, previous_snapshot_date, target_country_open, previous_country_open, previous_snapshot_date AS snapshot_date FROM periods), vendor_period AS (SELECT d.country_code, d.vendor_code, argMax(ifNull(d.vendor_name, ''), d.snapshot_date) AS vendor_name, sumIf(toInt64(d.past_due_count), d.snapshot_date = p.target_snapshot_date) AS target_past_due_count, sumIf(toInt64(d.past_due_count), d.snapshot_date = p.previous_snapshot_date) AS previous_past_due_count, sumIf(toInt64(d.total_open_count), d.snapshot_date = p.target_snapshot_date) AS target_open_count, sumIf(toInt64(d.total_open_count), d.snapshot_date = p.previous_snapshot_date) AS previous_open_count, p.target_snapshot_date, p.previous_snapshot_date, p.target_country_open, p.previous_country_open FROM past_due.vendor_past_due_daily d INNER JOIN period_rows p ON d.country_code = p.country_code AND d.snapshot_date = p.snapshot_date GROUP BY d.country_code, d.vendor_code, p.target_snapshot_date, p.previous_snapshot_date, p.target_country_open, p.previous_country_open), calculated AS (SELECT *, if(target_open_count > 0, toDecimal64(toFloat64(target_past_due_count) / target_open_count, 9), toDecimal64(0, 9)) AS target_vendor_ratio, if(previous_open_count > 0, toDecimal64(toFloat64(previous_past_due_count) / previous_open_count, 9), toDecimal64(0, 9)) AS previous_vendor_ratio, if(target_country_open > 0, toDecimal64(toFloat64(target_past_due_count) / target_country_open, 9), toDecimal64(0, 9)) AS target_country_contribution, if(previous_country_open > 0, toDecimal64(toFloat64(previous_past_due_count) / previous_country_open, 9), toDecimal64(0, 9)) AS previous_country_contribution, target_country_contribution - previous_country_contribution AS delta_country_contribution FROM vendor_period), positive AS (SELECT *, sum(delta_country_contribution) OVER () AS total_positive_delta FROM calculated WHERE delta_country_contribution > 0), ranked AS (SELECT *, row_number() OVER (ORDER BY delta_country_contribution DESC, vendor_code ASC) AS contribution_rank, ifNull(toDecimal64(delta_country_contribution / nullIf(total_positive_delta, 0), 9), toDecimal64(0, 9)) AS positive_contribution_share FROM positive) SELECT country_code, vendor_code, target_snapshot_date, previous_snapshot_date, vendor_name, target_past_due_count, previous_past_due_count, target_past_due_count - previous_past_due_count AS past_due_count_change, target_open_count, previous_open_count, target_open_count - previous_open_count AS open_count_change, target_vendor_ratio, previous_vendor_ratio, target_vendor_ratio - previous_vendor_ratio AS vendor_ratio_change, target_country_contribution, previous_country_contribution, delta_country_contribution, positive_contribution_share, toDecimal64(ifNull(sum(positive_contribution_share) OVER (ORDER BY contribution_rank ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW), toDecimal64(0, 9)), 9) AS cumulative_positive_share, toInt64(contribution_rank) AS contribution_rank FROM ranked"
    :params {"country_code" "pastdue.country-trigger-event/country-code"
             "target_snapshot_date" "pastdue.country-trigger-event/target-snapshot-date"
             "previous_snapshot_date" "pastdue.country-trigger-event/previous-snapshot-date"}
    :field_mapping
    {"pastdue.historical-vendor-contribution/country-code" "country_code"
     "pastdue.historical-vendor-contribution/vendor-code" "vendor_code"
     "pastdue.historical-vendor-contribution/target-snapshot-date" "target_snapshot_date"
     "pastdue.historical-vendor-contribution/previous-snapshot-date" "previous_snapshot_date"
     "pastdue.historical-vendor-contribution/vendor-name" "vendor_name"
     "pastdue.historical-vendor-contribution/target-past-due-count" "target_past_due_count"
     "pastdue.historical-vendor-contribution/previous-past-due-count" "previous_past_due_count"
     "pastdue.historical-vendor-contribution/past-due-count-change" "past_due_count_change"
     "pastdue.historical-vendor-contribution/target-open-count" "target_open_count"
     "pastdue.historical-vendor-contribution/previous-open-count" "previous_open_count"
     "pastdue.historical-vendor-contribution/open-count-change" "open_count_change"
     "pastdue.historical-vendor-contribution/target-vendor-ratio" "target_vendor_ratio"
     "pastdue.historical-vendor-contribution/previous-vendor-ratio" "previous_vendor_ratio"
     "pastdue.historical-vendor-contribution/vendor-ratio-change" "vendor_ratio_change"
     "pastdue.historical-vendor-contribution/target-country-contribution" "target_country_contribution"
     "pastdue.historical-vendor-contribution/previous-country-contribution" "previous_country_contribution"
     "pastdue.historical-vendor-contribution/delta-country-contribution" "delta_country_contribution"
     "pastdue.historical-vendor-contribution/positive-contribution-share" "positive_contribution_share"
     "pastdue.historical-vendor-contribution/cumulative-positive-share" "cumulative_positive_share"
     "pastdue.historical-vendor-contribution/contribution-rank" "contribution_rank"}}
   :eql-params
   {:limit {:type "integer" :field "_limit" :default 100 :description "Maximum vendor rows; return fixed positive Top-10 without stopping at 80 percent"}
    :offset {:type "integer" :field "_offset" :default 0 :description "Rows to skip"}
    :order_by {:type "string" :field "_order_by" :description "Mapped result column"}
    :sort_dir {:type "string" :field "_sort_dir" :description "ASC or DESC"}}}

  {:id "pastdue_historical_vendor_changes"
