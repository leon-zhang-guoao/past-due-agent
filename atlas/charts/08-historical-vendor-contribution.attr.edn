              "pastdue.historical-vendor-contribution/previous-snapshot-date"
              "pastdue.historical-vendor-contribution/vendor-name"
              "pastdue.historical-vendor-contribution/target-past-due-count"
              "pastdue.historical-vendor-contribution/previous-past-due-count"
              "pastdue.historical-vendor-contribution/past-due-count-change"
              "pastdue.historical-vendor-contribution/target-open-count"
              "pastdue.historical-vendor-contribution/previous-open-count"
              "pastdue.historical-vendor-contribution/open-count-change"
              "pastdue.historical-vendor-contribution/target-vendor-ratio"
              "pastdue.historical-vendor-contribution/previous-vendor-ratio"
              "pastdue.historical-vendor-contribution/vendor-ratio-change"
              "pastdue.historical-vendor-contribution/target-country-contribution"
              "pastdue.historical-vendor-contribution/previous-country-contribution"
              "pastdue.historical-vendor-contribution/delta-country-contribution"
              "pastdue.historical-vendor-contribution/positive-contribution-share"
              "pastdue.historical-vendor-contribution/cumulative-positive-share"
              "pastdue.historical-vendor-contribution/contribution-rank"]}]
   :source
   {:type "sql" :result_type "list"
    :query "WITH country_daily AS (SELECT snapshot_date, country_code, sum(toInt64(total_open_count)) AS country_open FROM past_due.vendor_past_due_daily WHERE snapshot_date < toDate(now('America/Los_Angeles')) AND country_code = :country_code GROUP BY snapshot_date, country_code), periods AS (SELECT country_code, toDate(:target_snapshot_date) AS target_snapshot_date, toDate(:previous_snapshot_date) AS previous_snapshot_date, sumIf(country_open, snapshot_date = toDate(:target_snapshot_date)) AS target_country_open, sumIf(country_open, snapshot_date = toDate(:previous_snapshot_date)) AS previous_country_open FROM country_daily GROUP BY country_code HAVING toDate(:target_snapshot_date) < toDate(now('America/Los_Angeles')) AND toDate(:previous_snapshot_date) < toDate(:target_snapshot_date) AND countIf(snapshot_date = toDate(:target_snapshot_date)) > 0 AND countIf(snapshot_date = toDate(:previous_snapshot_date)) > 0 AND maxIf(snapshot_date, snapshot_date < toDate(:target_snapshot_date)) = toDate(:previous_snapshot_date)), period_rows AS (SELECT country_code, target_snapshot_date, previous_snapshot_date, target_country_open, previous_country_open, target_snapshot_date AS snapshot_date FROM periods UNION ALL SELECT country_code, target_snapshot_date, previous_snapshot_date, target_country_open, previous_country_open, previous_snapshot_date AS snapshot_date FROM periods), vendor_period AS (SELECT d.country_code, d.vendor_code, argMax(ifNull(d.vendor_name, ''), d.snapshot_date) AS vendor_name, sumIf(toInt64(d.past_due_count), d.snapshot_date = p.target_snapshot_date) AS target_past_due_count, sumIf(toInt64(d.past_due_count), d.snapshot_date = p.previous_snapshot_date) AS previous_past_due_count, sumIf(toInt64(d.total_open_count), d.snapshot_date = p.target_snapshot_date) AS target_open_count, sumIf(toInt64(d.total_open_count), d.snapshot_date = p.previous_snapshot_date) AS previous_open_count, p.target_snapshot_date, p.previous_snapshot_date, p.target_country_open, p.previous_country_open FROM past_due.vendor_past_due_daily d INNER JOIN period_rows p ON d.country_code = p.country_code AND d.snapshot_date = p.snapshot_date GROUP BY d.country_code, d.vendor_code, p.target_snapshot_date, p.previous_snapshot_date, p.target_country_open, p.previous_country_open), calculated AS (SELECT *, if(target_open_count > 0, toDecimal64(toFloat64(target_past_due_count) / target_open_count, 9), toDecimal64(0, 9)) AS target_vendor_ratio, if(previous_open_count > 0, toDecimal64(toFloat64(previous_past_due_count) / previous_open_count, 9), toDecimal64(0, 9)) AS previous_vendor_ratio, if(target_country_open > 0, toDecimal64(toFloat64(target_past_due_count) / target_country_open, 9), toDecimal64(0, 9)) AS target_country_contribution, if(previous_country_open > 0, toDecimal64(toFloat64(previous_past_due_count) / previous_country_open, 9), toDecimal64(0, 9)) AS previous_country_contribution, target_country_contribution - previous_country_contribution AS delta_country_contribution FROM vendor_period), totals AS (SELECT *, sumIf(delta_country_contribution, delta_country_contribution > 0) OVER () AS total_positive_delta FROM calculated), ranked AS (SELECT *, if(delta_country_contribution > 0, row_number() OVER (ORDER BY if(delta_country_contribution > 0, 0, 1), delta_country_contribution DESC, vendor_code ASC), 0) AS contribution_rank, if(delta_country_contribution > 0 AND total_positive_delta > 0, toDecimal64(delta_country_contribution / total_positive_delta, 9), toDecimal64(0, 9)) AS positive_contribution_share FROM totals) SELECT country_code, vendor_code, target_snapshot_date, previous_snapshot_date, vendor_name, target_past_due_count, previous_past_due_count, target_past_due_count - previous_past_due_count AS past_due_count_change, target_open_count, previous_open_count, target_open_count - previous_open_count AS open_count_change, target_vendor_ratio, previous_vendor_ratio, target_vendor_ratio - previous_vendor_ratio AS vendor_ratio_change, target_country_contribution, previous_country_contribution, delta_country_contribution, positive_contribution_share, toDecimal64(ifNull(if(delta_country_contribution > 0, sum(positive_contribution_share) OVER (ORDER BY if(delta_country_contribution > 0, 0, 1), delta_country_contribution DESC, vendor_code ASC ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW), toDecimal64(0, 9)), toDecimal64(0, 9)), 9) AS cumulative_positive_share, toInt64(contribution_rank) AS contribution_rank FROM ranked"
    :params {"country_code" "pastdue.country-trigger-event/country-code"
             "target_snapshot_date" "pastdue.country-trigger-event/target-snapshot-date"
             "previous_snapshot_date" "pastdue.country-trigger-event/previous-snapshot-date"}
