    :attributes {:pastdue.country-history-query/comparisons {:attribute/label "Comparisons"
        :attribute/type :ref
        :attribute/nullable? false
        :attribute/description "Rows returned by Historical Country Comparisons: Return every comparable target snapshot in an inclusive PST date range of at most 366 calendar dates. Requires all four pastdue.country-history-query inputs in :entity: country-code, range-start-date, range-end-date, relative-change-threshold. Threshold classifies trigger-type without filtering normal dates. Not an empty-entity root collection."
        :attribute/target "pastdue.country-trigger-event"
        :attribute/cardinality :many}
      :pastdue.country-history-query/country-code {:attribute/label "Country Code"
        :attribute/type :string
        :attribute/nullable? false
        :attribute/description "Country to scan; Atlas supports every actual country while the Agent policy monitors US and CA."
        :attribute/synonyms ["国家" "国家代码" "country"]
        :attribute/format :code}
      :pastdue.country-history-query/range-end-date {:attribute/label "Range End Date"
        :attribute/type :date
        :attribute/nullable? false
        :attribute/description "Inclusive PST target-snapshot end date; only completed dates before the current PST date are eligible."
        :attribute/synonyms ["回溯结束日期" "历史结束日期"]
        :attribute/format :date}
      :pastdue.country-history-query/range-start-date {:attribute/label "Range Start Date"
        :attribute/type :date
        :attribute/nullable? false
        :attribute/description "Inclusive PST target-snapshot start date. The comparison snapshot may be earlier than this date."
        :attribute/synonyms ["回溯开始日期" "历史开始日期"]
        :attribute/format :date}
      :pastdue.country-history-query/relative-change-threshold {:attribute/label "Relative Change Threshold"
        :attribute/type :decimal
        :attribute/nullable? false
        :attribute/description "Required numeric fraction for both historical collections: filters trigger-events and classifies trigger-type in comparisons. 0.10 means 10%. Supply together with country-code, range-start-date and range-end-date."
        :attribute/synonyms ["历史触发阈值"]
        :attribute/format :percent
        :attribute/unit "%"}
      :pastdue.country-history-query/trigger-events {:attribute/label "Trigger Events"
        :attribute/type :ref
        :attribute/nullable? false
        :attribute/description "Rows returned by Historical Country Trigger Events: Return only historical comparisons meeting the supplied unrounded relative threshold or the zero-baseline rule. Requires all four pastdue.country-history-query inputs in :entity: country-code, range-start-date, range-end-date, relative-change-threshold. Not an empty-entity root collection. Child ratio/type attributes are target-past-due-ratio and trigger-type."
        :attribute/target "pastdue.country-trigger-event"
        :attribute/cardinality :many}
      :pastdue.country-monitor/all {:attribute/label "All"
        :attribute/type :ref
        :attribute/nullable? false
        :attribute/description "Rows returned by All Country Monitors: Return latest-versus-previous completed PST snapshot facts for every country present in the daily table."
        :attribute/target "pastdue.country-monitor"
        :attribute/cardinality :many}
      :pastdue.country-monitor/country-code {:attribute/label "Country Code"
        :attribute/type :string
        :attribute/nullable? false
        :attribute/description "Country independently monitored in the latest two completed snapshots."
        :attribute/synonyms ["国家" "国家代码" "country"]
        :attribute/format :code}
      :pastdue.country-monitor/has-comparable-snapshots {:attribute/label "Has Comparable Snapshots"
        :attribute/type :boolean
        :attribute/nullable? false
        :attribute/description "True when at least two completed snapshots exist for the country."
        :attribute/synonyms ["存在两个可比较快照"]}
      :pastdue.country-monitor/latest-open-count {:attribute/label "Latest Open Count"
        :attribute/type :integer
        :attribute/nullable? false
        :attribute/description "All open PO-line count used as the latest country denominator."
        :attribute/synonyms ["最新开放行数" "latest denominator"]
        :attribute/format :number
        :attribute/unit "PO lines"}
      :pastdue.country-monitor/latest-past-due-count {:attribute/label "Latest Past-Due Count"
        :attribute/type :integer
        :attribute/nullable? false
        :attribute/description "Past-due open PO-line count in the latest completed snapshot."
        :attribute/synonyms ["最新逾期行数"]
        :attribute/format :number
        :attribute/unit "PO lines"}
      :pastdue.country-monitor/latest-past-due-ratio {:attribute/label "Latest Past-Due Ratio"
        :attribute/type :decimal
        :attribute/nullable? false
        :attribute/description "Latest country past-due count divided by latest country open count, calculated without presentation rounding."
        :attribute/synonyms ["最新逾期率" "latest past due ratio"]
        :attribute/format :percent
        :attribute/unit "%"}
      :pastdue.country-monitor/latest-snapshot-age-days {:attribute/label "Latest Snapshot Age Days"
        :attribute/type :integer
        :attribute/nullable? false
        :attribute/description "PST calendar days from the latest completed snapshot date to the current PST date."
        :attribute/synonyms ["最新快照陈旧天数"]
        :attribute/format :number
        :attribute/unit "days"}
      :pastdue.country-monitor/latest-snapshot-date {:attribute/label "Latest Snapshot Date"
        :attribute/type :date
        :attribute/nullable? false
        :attribute/description "Most recent snapshot date strictly earlier than the current PST date."
        :attribute/synonyms ["最新完整快照日期" "latest completed snapshot"]
        :attribute/format :date}
      :pastdue.country-monitor/open-count-change {:attribute/label "Open Count Change"
        :attribute/type :integer
        :attribute/nullable? true
        :attribute/description "Latest minus previous open PO-line count."
        :attribute/synonyms ["开放行数变化"]
        :attribute/format :number
        :attribute/unit "PO lines"}
      :pastdue.country-monitor/past-due-count-change {:attribute/label "Past-Due Count Change"
        :attribute/type :integer
        :attribute/nullable? true
        :attribute/description "Latest minus previous past-due PO-line count."
        :attribute/synonyms ["逾期行数变化"]
        :attribute/format :number
        :attribute/unit "PO lines"}
      :pastdue.country-monitor/percentage-point-change {:attribute/label "Percentage-Point Change"
        :attribute/type :decimal
        :attribute/nullable? true
        :attribute/description "Latest past-due ratio minus previous past-due ratio; displayed for context but not used as a trigger threshold."
        :attribute/synonyms ["百分点变化" "ratio point change"]
        :attribute/format :number
        :attribute/unit "percentage points"}
      :pastdue.country-monitor/positive-vendor-contributors {:attribute/label "Positive Vendor Contributors"
        :attribute/type :ref
        :attribute/nullable? false
        :attribute/description "Rows returned by Positive Vendor Contributors: Positive vendor contributors for a country, pre-ranked with cumulative positive share; the Skill selects fixed positive Top-10; 80 percent is only a coverage reference."
        :attribute/target "pastdue.vendor-contribution"
        :attribute/cardinality :many}
      :pastdue.country-monitor/previous-open-count {:attribute/label "Previous Open Count"
        :attribute/type :integer
        :attribute/nullable? true
        :attribute/description "All open PO-line count used as the previous country denominator."
        :attribute/synonyms ["上期开放行数" "previous denominator"]
        :attribute/format :number
        :attribute/unit "PO lines"}
      :pastdue.country-monitor/previous-past-due-count {:attribute/label "Previous Past-Due Count"
        :attribute/type :integer
        :attribute/nullable? true
        :attribute/description "Past-due open PO-line count in the previous completed snapshot."
        :attribute/synonyms ["上期逾期行数"]
        :attribute/format :number
        :attribute/unit "PO lines"}
      :pastdue.country-monitor/previous-past-due-ratio {:attribute/label "Previous Past-Due Ratio"
        :attribute/type :decimal
        :attribute/nullable? true
        :attribute/description "Previous country past-due count divided by previous country open count, calculated without presentation rounding."
        :attribute/synonyms ["上期逾期率" "previous past due ratio"]
        :attribute/format :percent
        :attribute/unit "%"}
      :pastdue.country-monitor/previous-snapshot-date {:attribute/label "Previous Snapshot Date"
        :attribute/type :date
        :attribute/nullable? true
        :attribute/description "Most recent available completed snapshot before the latest snapshot for this country."
        :attribute/synonyms ["上一快照日期" "previous completed snapshot"]
        :attribute/format :date}
      :pastdue.country-monitor/relative-ratio-change {:attribute/label "Relative Ratio Change"
        :attribute/type :decimal
        :attribute/nullable? true
        :attribute/description "Relative change in country past-due ratio; null when the previous ratio is zero or unavailable."
        :attribute/synonyms ["逾期率相对变化" "relative growth"]
        :attribute/format :percent
        :attribute/unit "%"}
      :pastdue.country-monitor/snapshot-gap-days {:attribute/label "Snapshot Gap Days"
        :attribute/type :integer
        :attribute/nullable? true
        :attribute/description "Calendar-day gap between the latest and previous available snapshot dates."
        :attribute/synonyms ["快照间隔天数"]
        :attribute/format :number
        :attribute/unit "days"}
      :pastdue.country-monitor/vendor-master-mapping-rollups {:attribute/label "Vendor Master Mapping Rollups"
        :attribute/type :ref
        :attribute/nullable? false
        :attribute/description "Rows returned by Vendor Master Mapping Rollups by Country: department/primary/manager vendor concentration from vendor_master_mapping_view."
        :attribute/target "pastdue.vendor-master-mapping-rollup"
        :attribute/cardinality :many}
      :pastdue.country-monitor/vendor-changes {:attribute/label "Vendor Changes"
        :attribute/type :ref
        :attribute/nullable? false
        :attribute/description "Rows returned by All Vendor Changes: All vendor changes, including positive, negative and zero contribution, for questions about deterioration and offsets."
        :attribute/target "pastdue.vendor-contribution"
        :attribute/cardinality :many}
      :pastdue.country-monitor/zero-baseline-increase {:attribute/label "Zero Baseline Increase"
        :attribute/type :boolean
        :attribute/nullable? false
        :attribute/description "True when the previous ratio is zero and the latest ratio is greater than zero."
        :attribute/synonyms ["零基线上升"]}
      :pastdue.country-trigger-event/country-code {:attribute/label "Country Code"
        :attribute/type :string
        :attribute/nullable? false
        :attribute/description "Country for this historical comparison event."
        :attribute/format :code}
      :pastdue.country-trigger-event/percentage-point-change {:attribute/label "Percentage-Point Change"
        :attribute/type :decimal
        :attribute/nullable? false
        :attribute/description "Target ratio minus previous ratio; context only and not an additional trigger threshold."
        :attribute/format :number
        :attribute/unit "percentage points"}
      :pastdue.country-trigger-event/positive-vendor-contributors {:attribute/label "Positive Vendor Contributors"
        :attribute/type :ref
        :attribute/nullable? false
        :attribute/description "Rows returned by Historical Positive Vendor Contributors: Positive vendor contributors for an explicit valid historical snapshot pair. The previous date must be the nearest available date before the target."
        :attribute/target "pastdue.historical-vendor-contribution"
        :attribute/cardinality :many}
      :pastdue.country-trigger-event/previous-open-count {:attribute/label "Previous Open Count"
        :attribute/type :integer
        :attribute/nullable? false
        :attribute/description "Country open PO-line denominator in the previous snapshot."
        :attribute/format :number
        :attribute/unit "PO lines"}
      :pastdue.country-trigger-event/previous-past-due-count {:attribute/label "Previous Past-Due Count"
        :attribute/type :integer
        :attribute/nullable? false
        :attribute/description "Country past-due PO-line count in the previous snapshot."
        :attribute/format :number
        :attribute/unit "PO lines"}
      :pastdue.country-trigger-event/previous-past-due-ratio {:attribute/label "Previous Past-Due Ratio"
        :attribute/type :decimal
        :attribute/nullable? false
        :attribute/description "Unrounded previous country past-due ratio."
        :attribute/format :percent
        :attribute/unit "%"}
      :pastdue.country-trigger-event/previous-snapshot-date {:attribute/label "Previous Snapshot Date"
        :attribute/type :date
        :attribute/nullable? false
        :attribute/description "Nearest available completed snapshot before the target snapshot for the same country."
        :attribute/synonyms ["上一可用快照日期"]
        :attribute/format :date}
      :pastdue.country-trigger-event/relative-ratio-change {:attribute/label "Relative Ratio Change"
        :attribute/type :decimal
        :attribute/nullable? true
        :attribute/description "Relative change from the previous ratio to the target ratio; null for a zero baseline."
        :attribute/format :percent
        :attribute/unit "%"}
      :pastdue.country-trigger-event/snapshot-gap-days {:attribute/label "Snapshot Gap Days"
        :attribute/type :integer
        :attribute/nullable? false
        :attribute/description "Calendar-day gap between the previous and target snapshots."
        :attribute/format :number
        :attribute/unit "days"}
      :pastdue.country-trigger-event/target-open-count {:attribute/label "Target Open Count"
        :attribute/type :integer
        :attribute/nullable? false
        :attribute/description "Country open PO-line denominator in the target snapshot."
        :attribute/format :number
        :attribute/unit "PO lines"}
      :pastdue.country-trigger-event/target-past-due-count {:attribute/label "Target Past-Due Count"
        :attribute/type :integer
        :attribute/nullable? false
        :attribute/description "Country past-due PO-line count in the target snapshot."
        :attribute/format :number
        :attribute/unit "PO lines"}
      :pastdue.country-trigger-event/target-past-due-ratio {:attribute/label "Target Past-Due Ratio"
        :attribute/type :decimal
        :attribute/nullable? false
        :attribute/description "Unrounded target country past-due ratio."
        :attribute/format :percent
        :attribute/unit "%"}
      :pastdue.country-trigger-event/target-snapshot-date {:attribute/label "Target Snapshot Date"
        :attribute/type :date
        :attribute/nullable? false
        :attribute/description "Completed PST snapshot date whose change is being evaluated."
        :attribute/synonyms ["目标快照日期" "历史触发日期"]
        :attribute/format :date}
      :pastdue.country-trigger-event/trigger-type {:attribute/label "Trigger Type"
