          :pastdue.analysis-vendor/contribution-rank "contribution_rank"
          :pastdue.analysis-vendor/selected-vendor-count "selected_vendor_count"
          :pastdue.analysis-vendor/vendor-name "vendor_name"
          :pastdue.analysis-vendor/target-vendor-ratio "target_vendor_ratio"
          :pastdue.analysis-vendor/previous-vendor-ratio "previous_vendor_ratio"
          :pastdue.analysis-vendor/target-country-contribution "target_country_contribution"
          :pastdue.analysis-vendor/previous-country-contribution "previous_country_contribution"
          :pastdue.analysis-vendor/delta-country-contribution "delta_country_contribution"
          :pastdue.analysis-vendor/positive-contribution-share "positive_contribution_share"
          :pastdue.analysis-vendor/selected-positive-coverage "selected_positive_coverage"}}
