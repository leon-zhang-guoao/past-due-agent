n_count, t.target_country_open AS target_country_open, t.previous_country_open AS previous_country_open, t.contribution_rank AS contribution_rank, t.selected_vendor_count AS selected_vendor_count, t.target_vendor_ratio AS target_vendor_ratio, t.previous_vendor_ratio AS previous_vendor_ratio, t.target_country_contribution AS target_country_contribution, t.previous_country_contribution AS previous_country_contribution, if(t.tag IN ('ETA_CODE_SUMMARY','ETA_SOURCE_SUMMARY','US_SOURCE_SUMMARY'),toDecimal128(toDecimal256(if(t.display_rank=6,t.other_target,t.target_count), 18) / nullIf(toDecimal256(t.target_country_open, 18), 0), 18)-toDecimal128(toDecimal256(if(t.display_rank=6,t.other_previous,t.previous_count), 18) / nullIf(toDecimal256(t.previous_country_open, 18), 0), 18),t.delta_country_contribution) AS delta_country_contribution, t.positive_contribution_share AS positive_contribution_share, t.selected_positive_coverage AS selected_positive_coverage, if(t.tag IN ('ETA_CODE_SUMMARY','ETA_SOURCE_SUMMARY','US_SOURCE_SUMMARY'),t.display_rank,toInt64(0)) AS display_rank, t.expected_bucket_count AS expected_bucket_count, if(t.tag IN ('ETA_CODE_SUMMARY','ETA_SOURCE_SUMMARY','US_SOURCE_SUMMARY') AND t.display_rank=6,t.other_bucket_count,toInt64(0)) AS other_bucket_count, t.increase_total AS increase_total, t.decrease_total AS decrease_total, t.target_total-t.previous_total AS net_change, t.previous_total AS previous_total, t.target_total AS target_total, t.previous_expected_total AS previous_expected_total, t.target_expected_total AS target_expected_total, toInt64(0) AS expected_record_count, toInt64(0) AS row_ordinal, t.previous_total=t.previous_expected_total AND t.target_total=t.target_expected_total AS counts_match, t.required AS required, toDecimal128(toDecimal256(if(t.display_rank=6,t.other_target,t.target_count)-if(t.display_rank=6,t.other_previous,t.previous_count), 18) / nullIf(toDecimal256(if(t.display_rank=6,t.other_previous,t.previous_count), 18), 0), 18) AS past