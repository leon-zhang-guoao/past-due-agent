          "ZERO_BASELINE_INCREASE" {:label "Zero baseline increase"}}}
      :pastdue.country-trigger-event/vendor-changes {:attribute/label "Vendor Changes"
        :attribute/type :ref
        :attribute/nullable? false
        :attribute/description "Rows returned by Historical Vendor Changes: All positive, negative, and zero vendor changes for an explicit valid historical snapshot pair."
        :attribute/target "pastdue.historical-vendor-contribution"
        :attribute/cardinality :many}
      :pastdue.country-trigger-event/zero-baseline-increase {:attribute/label "Zero Baseline Increase"
        :attribute/type :boolean
