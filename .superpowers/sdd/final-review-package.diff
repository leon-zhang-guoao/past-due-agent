+            bad_out = Path(tmp) / "bad.html"
+            bad = FIX / "html-report-payload-gate-fail.json"
+            r = subprocess.run(
+                [sys.executable, str(SCRIPTS / "render_ops_shell.py"), str(bad), "-o", str(bad_out)],
